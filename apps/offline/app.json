{
  "expo": {
    "name": "Core",
    "slug": "core-personal-offline",
    "scheme": "coreoffline",
    "version": "0.2.1",
    "backgroundColor": "#000000",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.corepersonal.offline",
      "buildNumber": "3"
    },
    "android": {
      "package": "br.com.corepersonal.offline"
    },
    "web": {
      "bundler": "metro",
      "name": "Core Personal Offline",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma foto para personalizar seu perfil no Core.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "resizeMode": "contain",
          "imageWidth": 320
        }
      ]
    ]
  }
}
