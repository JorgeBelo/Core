{
  "name": "core-personal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "offline": "pnpm --filter @core/offline start",
    "offline:web": "pnpm --filter @core/offline web",
    "offline:build": "pnpm --filter @core/offline build:web",
    "offline:typecheck": "pnpm --filter @core/offline typecheck",
    "dev": "pnpm --filter @core/mobile start",
    "web": "pnpm --filter @core/mobile web",
    "preview": "node scripts/serve-web.mjs",
    "typecheck": "pnpm --filter @core/mobile typecheck",
    "test": "vitest run",
    "test:ui": "node scripts/build-e2e.mjs && playwright test",
    "build:web": "pnpm --filter @core/mobile build:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdk:check": "node scripts/check-sdk.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.7.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
